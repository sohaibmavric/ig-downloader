# Instagram blocks most anonymous requests from servers/datacenters.
# Paste the `sessionid` cookie of an Instagram account (DevTools > Application >
# Cookies > instagram.com). Use a secondary account, not your main one.
IG_SESSIONID=

# Optional: path to a system ffmpeg binary (defaults to the bundled ffmpeg-static).
FFMPEG_PATH=

# Production origin, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: search console ownership verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics and
# events are disabled when unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
